{
    "name": "dxgx/blade-tailwind-extract",
    "description": "Extract Tailwind CSS classes to reduce Livewire wire transfer size",
    "keywords": [
        "laravel",
        "tailwindcss",
        "livewire",
        "performance",
        "blade",
        "dxgx"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "dxgx",
            "email": "packages@dxgx.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Dxgx\\BladeTailwindExtract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dxgx\\BladeTailwindExtract\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dxgx\\BladeTailwindExtract\\BladeTailwindExtractServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
